# Copy to terraform.tfvars and fill in (terraform.tfvars is gitignored).
#
#   cp terraform.tfvars.example terraform.tfvars

mgmt_url      = "https://ptkos.example"
mgmt_user     = "admin"
mgmt_password = "change-me"
mgmt_insecure = true

pve_url          = "https://10.1.1.10:8006"
pve_token_id     = "root@pam!pertisk"
pve_token_secret = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
pve_node         = "pve"
pve_storage      = "local-lvm"
pve_bridge       = "vmbr0"
pve_insecure     = true

cluster_name  = "tf-lab"
cp_vmid       = 310
k8s_version   = "v1.36.3"
cni           = "cilium"
extra_worker  = true

# --- Single-node (IPv4) ---
# controlplanes = 1
# workers       = 1
# network_mode  = "ipv4"

# --- HA + dual-stack (kube-vip) ---
# VIP must be free on L2 and outside the DHCP pool.
controlplanes = 3
workers       = 2
network_mode  = "dual-stack"
vip           = "10.1.1.210"
vip6          = "fd00:1::210"
# Optional overrides (omit → mgmt dual-stack defaults):
# pod_subnet_ipv6     = "2001:db8:10:0::/56"
# service_subnet_ipv6 = "2001:db8:96:1::/112"

# VM sizing (MB / vCPU / GiB)
cp_memory      = 4096
cp_cores       = 2
cp_disk_gb     = 50
worker_memory  = 8192
worker_cores   = 4
worker_disk_gb = 75
