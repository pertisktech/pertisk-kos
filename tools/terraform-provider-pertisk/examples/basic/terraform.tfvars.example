# Copy to terraform.tfvars and fill in (terraform.tfvars is gitignored).
#
#   cp terraform.tfvars.example terraform.tfvars

mgmt_url      = "https://ptkos.example"
mgmt_user     = "admin"
mgmt_password = "change-me"
mgmt_insecure = true

pve_url          = "https://10.1.1.10:8006"
pve_token_id     = "root@pam!pertisk"
pve_token_secret = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
pve_node         = "pve"
pve_storage      = "local-lvm"
pve_bridge       = "vmbr0"
pve_insecure     = true

cluster_name  = "tf-lab"
controlplanes = 1
workers       = 1
cp_vmid       = 310
k8s_version   = "v1.36.3"
cni           = "cilium"
extra_worker  = true
