# syntax=docker/dockerfile:1
# Build Rust on $BUILDPLATFORM (native), cross-compile to TARGETARCH musl.
# Avoids broken amd64 Rust codegen under qemu-user on Apple Silicon.

ARG TARGETARCH
ARG BUILDPLATFORM

# ratatui / instability currently require rustc ≥ 1.88
FROM --platform=$BUILDPLATFORM rust:1.88-bookworm AS build
ARG TARGETARCH
ARG BUILDPLATFORM
ARG ZIG_VERSION=0.13.0
# OS / binary version (override: docker --build-arg VERSION=... or make VERSION=...)
ARG VERSION=0.1.0
ENV PERTISK_BUILD_VERSION=${VERSION}
WORKDIR /src

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    xz-utils \
    protobuf-compiler \
    file \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Zig cross linker for the builder CPU (not the target).
RUN BUILD_ARCH="$(echo "${BUILDPLATFORM}" | cut -d/ -f2)" \
    && case "${BUILD_ARCH}" in \
         amd64) ZIG_ARCH=x86_64 ;; \
         arm64) ZIG_ARCH=aarch64 ;; \
         *) echo "unsupported BUILDPLATFORM=${BUILDPLATFORM}" >&2; exit 1 ;; \
       esac \
    && curl -fsSL "https://ziglang.org/download/${ZIG_VERSION}/zig-linux-${ZIG_ARCH}-${ZIG_VERSION}.tar.xz" \
         -o /tmp/zig.tar.xz \
    && tar -xJf /tmp/zig.tar.xz -C /opt \
    && ln -s "/opt/zig-linux-${ZIG_ARCH}-${ZIG_VERSION}/zig" /usr/local/bin/zig \
    && zig version

# Map Docker TARGETARCH → Rust triple; install musl target + prebuilt cargo-zigbuild
# (compiling cargo-zigbuild from crates.io takes ~10m on a cold layer).
ARG CARGO_ZIGBUILD_VERSION=0.21.8
RUN case "${TARGETARCH}" in \
      amd64) echo x86_64-unknown-linux-musl > /tmp/rust-target ;; \
      arm64) echo aarch64-unknown-linux-musl > /tmp/rust-target ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && rustup target add "$(cat /tmp/rust-target)" \
    && BUILD_ARCH="$(echo "${BUILDPLATFORM}" | cut -d/ -f2)" \
    && case "${BUILD_ARCH}" in \
         amd64) ZB_TRIPLE=x86_64-unknown-linux-gnu ;; \
         arm64) ZB_TRIPLE=aarch64-unknown-linux-gnu ;; \
         *) echo "unsupported BUILDPLATFORM=${BUILDPLATFORM}" >&2; exit 1 ;; \
       esac \
    && curl -fsSL \
         "https://github.com/rust-cross/cargo-zigbuild/releases/download/v${CARGO_ZIGBUILD_VERSION}/cargo-zigbuild-${ZB_TRIPLE}.tar.xz" \
         -o /tmp/cargo-zigbuild.tar.xz \
    && tar -xJf /tmp/cargo-zigbuild.tar.xz -C /tmp \
    && install -m 755 "/tmp/cargo-zigbuild-${ZB_TRIPLE}/cargo-zigbuild" /usr/local/cargo/bin/cargo-zigbuild \
    && rm -rf /tmp/cargo-zigbuild.tar.xz "/tmp/cargo-zigbuild-${ZB_TRIPLE}" \
    && command -v cargo-zigbuild \
    && cargo zigbuild --help >/dev/null

COPY Cargo.toml Cargo.lock ./
COPY .cargo ./.cargo
COPY crates ./crates
COPY examples ./examples
COPY proto ./proto

# Native BUILDPLATFORM rustc + Zig cross link (avoids qemu-user codegen bugs).
# PERTISK_BUILD_VERSION (from ARG VERSION) is baked into release_version().
# Note: a single `--bin NAME` filters the whole build to that binary only, so
# build packages separately (pertiskd + power helper + udhcpc hook).
# Cache mounts keep crates.io + target/ across rebuilds (needs BuildKit).
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/src/target,sharing=locked \
    RUST_TARGET="$(cat /tmp/rust-target)" \
    && echo "==> cargo zigbuild PERTISK_BUILD_VERSION=${PERTISK_BUILD_VERSION} target=${RUST_TARGET}" \
    && cargo zigbuild --release -p pertiskd --bin pertiskd --target "${RUST_TARGET}" \
    && cargo zigbuild --release -p pertiskd --bin pertisk-power --target "${RUST_TARGET}" \
    && cargo zigbuild --release -p pertisk-net --bin pertisk-udhcpc-hook --target "${RUST_TARGET}" \
    && cp "target/${RUST_TARGET}/release/pertiskd" /pertiskd \
    && cp "target/${RUST_TARGET}/release/pertisk-power" /pertisk-power \
    && cp "target/${RUST_TARGET}/release/pertisk-udhcpc-hook" /pertisk-udhcpc-hook \
    && file /pertiskd /pertisk-power /pertisk-udhcpc-hook \
    && for bin in /pertiskd /pertisk-power /pertisk-udhcpc-hook; do \
         if ! file "$bin" | grep -Eqi 'statically linked|static-pie'; then \
           echo "ERROR: $bin must be statically linked for initramfs" >&2; \
           exit 1; \
         fi; \
       done

FROM alpine:3.20 AS tools
ARG TARGETARCH
RUN apk add --no-cache sgdisk e2fsprogs e2fsprogs-extra dosfstools busybox parted util-linux ca-certificates \
    iptables iptables-legacy \
    nfs-utils \
    qemu-guest-agent \
    iproute2 \
    && mkdir -p /tools/bin /tools/lib /tools/certs /tools/xtables \
    && cp /usr/bin/sgdisk /usr/sbin/partprobe /sbin/mkfs.ext4 /sbin/mkfs.vfat /usr/sbin/resize2fs /usr/sbin/tune2fs /sbin/blkid /bin/busybox /tools/bin/ \
    && cp /usr/bin/qemu-ga /tools/bin/ \
    && cp /etc/ssl/certs/ca-certificates.crt /tools/certs/ \
    # util-linux mount/umount (kubelet volumes) — not BusyBox applets.
    && cp /bin/mount /bin/umount /tools/bin/ \
    # iproute2 `ip` for net helpers / dashboard fallback.
    && cp /sbin/ip /tools/bin/ \
    # NFS client helpers (mount -t nfs looks for /sbin/mount.nfs).
    && cp /sbin/mount.nfs /sbin/mount.nfs4 /sbin/umount.nfs /sbin/umount.nfs4 /tools/bin/ \
    # Host iptables for Flannel/Calico CNI + kube-proxy (legacy; nft is incomplete on linux-virt).
    && (cp -a /sbin/xtables-legacy-multi /tools/bin/ 2>/dev/null \
        || cp -a /usr/sbin/xtables-legacy-multi /tools/bin/) \
    && ln -sf xtables-legacy-multi /tools/bin/iptables \
    && ln -sf xtables-legacy-multi /tools/bin/iptables-legacy \
    && ln -sf xtables-legacy-multi /tools/bin/iptables-save \
    && ln -sf xtables-legacy-multi /tools/bin/iptables-restore \
    && ln -sf xtables-legacy-multi /tools/bin/ip6tables \
    && ln -sf xtables-legacy-multi /tools/bin/ip6tables-legacy \
    && cp -a /usr/lib/xtables/. /tools/xtables/ \
    && for bin in /tools/bin/sgdisk /tools/bin/mkfs.ext4 /tools/bin/mkfs.vfat /tools/bin/resize2fs /tools/bin/tune2fs /tools/bin/blkid /tools/bin/partprobe /tools/bin/xtables-legacy-multi /tools/bin/mount /tools/bin/umount /tools/bin/ip /tools/bin/mount.nfs /tools/bin/mount.nfs4 /tools/bin/umount.nfs /tools/bin/umount.nfs4 /tools/bin/qemu-ga; do \
         [ -f "$bin" ] || continue; \
         ldd "$bin" 2>/dev/null | awk '{print $3}' | grep -E '^/' | while read -r lib; do cp -n "$lib" /tools/lib/; done; \
       done \
    # nfs-utils / util-linux also need libtirpc / libmount / libblkid (ldd can miss some dlopen paths).
    && for lib in /usr/lib/libtirpc.so.3* /lib/libtirpc.so.3* /usr/lib/libmount.so.1* /lib/libmount.so.1* \
                  /usr/lib/libblkid.so.1* /lib/libblkid.so.1* /usr/lib/libuuid.so.1* /lib/libuuid.so.1* \
                  /usr/lib/libsmartcols.so.1* /lib/libsmartcols.so.1* /usr/lib/libcap.so.2* /lib/libcap.so.2* \
                  /usr/lib/libelf.so.1* /lib/libelf.so.1* /usr/lib/libmnl.so.0* /lib/libmnl.so.0* \
                  /usr/lib/libbsd.so.0* /lib/libbsd.so.0* /usr/lib/libmd.so.0* /lib/libmd.so.0*; do \
         [ -e "$lib" ] || continue; \
         cp -an "$lib" /tools/lib/ 2>/dev/null || cp -n "$lib" /tools/lib/; \
       done \
    # qemu-ga nested deps (glib → pcre2/intl already via ldd; keep globs for so names).
    && for lib in /usr/lib/libnuma.so.1* /usr/lib/liburing.so.2* /usr/lib/libglib-2.0.so.0* \
                  /usr/lib/libgmodule-2.0.so.0* /usr/lib/libintl.so.8* /usr/lib/libpcre2-8.so.0*; do \
         [ -e "$lib" ] || continue; \
         cp -an "$lib" /tools/lib/ 2>/dev/null || cp -n "$lib" /tools/lib/; \
       done \
    && case "${TARGETARCH}" in \
         amd64) cp /lib/ld-musl-x86_64.so.1 /tools/lib/ ;; \
         arm64) cp /lib/ld-musl-aarch64.so.1 /tools/lib/ ;; \
       esac

# Pack on Alpine (same as tools) — only needs cpio/gzip. Avoids flaky
# deb.debian.org fetches that only install those two packages.
FROM alpine:3.20 AS pack
ARG IMAGE_PROFILE=production
RUN apk add --no-cache cpio gzip
WORKDIR /rootfs
COPY image/rootfs/ ./
COPY image/boot-overlay/ ./
COPY --from=build /pertiskd ./init
COPY --from=build /pertisk-power ./usr/sbin/pertisk-power
# Disk/net helpers (required). BusyBox multi-call binary is only shipped as udhcpc
# (DHCP fallback) — no /bin/busybox shell entrypoint. Debug profile adds ash/sh.
# mount/umount = util-linux; ip = iproute2 (not BusyBox applets).
# DHCPv4 primary is in-process; udhcpc + /usr/lib/pertisk/udhcpc-hook is fallback.
COPY --from=tools /tools/bin/sgdisk /tools/bin/partprobe /tools/bin/mkfs.ext4 /tools/bin/mkfs.vfat /tools/bin/resize2fs /tools/bin/tune2fs /tools/bin/blkid ./usr/sbin/
COPY --from=tools /tools/bin/busybox ./usr/sbin/udhcpc
COPY --from=tools /tools/bin/qemu-ga ./usr/bin/qemu-ga
# util-linux mount/umount for kubelet projected volumes / subPath.
COPY --from=tools /tools/bin/mount /tools/bin/umount ./bin/
# iproute2
COPY --from=tools /tools/bin/ip ./sbin/ip
# NFS client (storage extension) — mount -t nfs → /sbin/mount.nfs
COPY --from=tools /tools/bin/mount.nfs /tools/bin/mount.nfs4 /tools/bin/umount.nfs /tools/bin/umount.nfs4 ./sbin/
# iptables-legacy for Flannel/Calico CNI + kube-proxy (host-path lookups).
COPY --from=tools /tools/bin/xtables-legacy-multi ./usr/sbin/xtables-legacy-multi
COPY --from=tools /tools/xtables/ ./usr/lib/xtables/
# Musl deps for disk tools first; glibc for containerd/kubelet overlays on top.
COPY --from=tools /tools/lib/ ./lib/
COPY image/runtime-overlay/ ./
# System CA bundle for containerd/kubelet image pulls (registry.k8s.io TLS).
RUN mkdir -p ./etc/ssl/certs
COPY --from=tools /tools/certs/ca-certificates.crt ./etc/ssl/certs/ca-certificates.crt
RUN mkdir -p proc sys dev run tmp var system/state etc/pertisk sbin \
       usr/local/bin usr/bin opt/cni/bin etc/cni/net.d etc/kubernetes/manifests boot/efi \
       usr/lib/pertisk/boot bin usr/lib/xtables \
    && chmod +x ./usr/sbin/xtables-legacy-multi \
    && ln -sf xtables-legacy-multi ./usr/sbin/iptables \
    && ln -sf xtables-legacy-multi ./usr/sbin/iptables-legacy \
    && ln -sf xtables-legacy-multi ./usr/sbin/iptables-save \
    && ln -sf xtables-legacy-multi ./usr/sbin/iptables-restore \
    && ln -sf xtables-legacy-multi ./usr/sbin/ip6tables \
    && ln -sf xtables-legacy-multi ./usr/sbin/ip6tables-legacy \
    && ln -sf /usr/sbin/iptables ./sbin/iptables \
    && ln -sf /usr/sbin/iptables-legacy ./sbin/iptables-legacy
COPY --from=build /pertisk-udhcpc-hook ./usr/lib/pertisk/udhcpc-hook
RUN chmod +x ./init ./usr/sbin/* ./usr/bin/qemu-ga ./usr/lib/pertisk/udhcpc-hook \
    && chmod +x ./bin/mount ./bin/umount ./sbin/ip \
    && chmod +x ./sbin/mount.nfs ./sbin/mount.nfs4 ./sbin/umount.nfs ./sbin/umount.nfs4 \
    && ln -sf /usr/sbin/sgdisk ./sbin/sgdisk \
    && ln -sf /usr/sbin/mkfs.ext4 ./sbin/mkfs.ext4 \
    && ln -sf /usr/sbin/mkfs.vfat ./sbin/mkfs.vfat \
    && ln -sf /usr/sbin/resize2fs ./sbin/resize2fs \
    && ln -sf /usr/sbin/tune2fs ./sbin/tune2fs \
    && ln -sf /usr/sbin/blkid ./sbin/blkid \
    && ln -sf /usr/sbin/partprobe ./sbin/partprobe \
    && ln -sf /usr/sbin/udhcpc ./sbin/udhcpc \
    && ln -sf /bin/mount ./sbin/mount \
    && ln -sf /bin/umount ./sbin/umount \
    && ln -sf /sbin/ip ./usr/sbin/ip \
    # qemu-ga guest-shutdown: Alpine tries /sbin/shutdown then /sbin/poweroff.
    # Do NOT use BusyBox poweroff here — without -f it waits on PID 1/init.
    && ln -sf /usr/sbin/pertisk-power ./sbin/poweroff \
    && ln -sf /usr/sbin/pertisk-power ./sbin/reboot \
    && ln -sf /usr/sbin/pertisk-power ./sbin/halt \
    && ln -sf /usr/sbin/pertisk-power ./sbin/shutdown \
    && ln -sf /usr/sbin/pertisk-power ./usr/sbin/poweroff \
    && ln -sf /usr/sbin/pertisk-power ./usr/sbin/reboot \
    && ln -sf /usr/sbin/pertisk-power ./usr/sbin/halt \
    && ln -sf /usr/sbin/pertisk-power ./usr/sbin/shutdown \
    && ln -sf /etc/ssl/certs/ca-certificates.crt ./etc/ssl/cert.pem \
    && echo "${IMAGE_PROFILE}" > ./etc/pertisk/image-profile \
    && if [ "${IMAGE_PROFILE}" = "debug" ]; then \
         cp ./usr/sbin/udhcpc ./bin/busybox \
         && ln -sf busybox ./bin/sh \
         && ln -sf busybox ./bin/ash \
         && chmod +x ./bin/busybox \
         && echo "debug profile: BusyBox ash enabled"; \
       else \
         # Production: no interactive shell; util-linux mount/umount + iproute2 ip.
         rm -f ./bin/busybox ./bin/sh ./bin/ash ./bin/bash \
         && echo "production profile: no shell; util-linux mount/umount + iproute2 ip"; \
       fi \
    && if [ -f ./usr/local/bin/containerd ]; then chmod +x ./usr/local/bin/*; fi \
    && if [ -f ./usr/local/bin/runc ]; then ln -sf /usr/local/bin/runc ./usr/bin/runc; fi \
    && if [ -f ./opt/cni/bin/loopback ]; then chmod +x ./opt/cni/bin/*; fi \
    && find . | cpio -o -H newc | gzip -9 > /tmp/initramfs-base.cpio.gz \
    && if [ -f usr/lib/pertisk/boot/kernel ]; then \
         cp /tmp/initramfs-base.cpio.gz usr/lib/pertisk/boot/initramfs; \
         find . | cpio -o -H newc | gzip -9 > /initramfs.cpio.gz; \
       else \
         cp /tmp/initramfs-base.cpio.gz /initramfs.cpio.gz; \
       fi

FROM scratch AS export
COPY --from=pack /initramfs.cpio.gz /initramfs.cpio.gz
