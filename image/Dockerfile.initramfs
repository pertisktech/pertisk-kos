# syntax=docker/dockerfile:1
# Build Rust on $BUILDPLATFORM (native), cross-compile to TARGETARCH musl.
# Avoids broken amd64 Rust codegen under qemu-user on Apple Silicon.

ARG TARGETARCH
ARG BUILDPLATFORM

FROM --platform=$BUILDPLATFORM rust:1.85-bookworm AS build
ARG TARGETARCH
ARG BUILDPLATFORM
ARG ZIG_VERSION=0.13.0
# OS / binary version (override: docker --build-arg VERSION=... or make VERSION=...)
ARG VERSION=0.1.0
ENV PERTISK_BUILD_VERSION=${VERSION}
WORKDIR /src

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    xz-utils \
    protobuf-compiler \
    file \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Zig cross linker for the builder CPU (not the target).
RUN BUILD_ARCH="$(echo "${BUILDPLATFORM}" | cut -d/ -f2)" \
    && case "${BUILD_ARCH}" in \
         amd64) ZIG_ARCH=x86_64 ;; \
         arm64) ZIG_ARCH=aarch64 ;; \
         *) echo "unsupported BUILDPLATFORM=${BUILDPLATFORM}" >&2; exit 1 ;; \
       esac \
    && curl -fsSL "https://ziglang.org/download/${ZIG_VERSION}/zig-linux-${ZIG_ARCH}-${ZIG_VERSION}.tar.xz" \
         -o /tmp/zig.tar.xz \
    && tar -xJf /tmp/zig.tar.xz -C /opt \
    && ln -s "/opt/zig-linux-${ZIG_ARCH}-${ZIG_VERSION}/zig" /usr/local/bin/zig \
    && zig version

# Map Docker TARGETARCH → Rust triple.
RUN case "${TARGETARCH}" in \
      amd64) echo x86_64-unknown-linux-musl > /tmp/rust-target ;; \
      arm64) echo aarch64-unknown-linux-musl > /tmp/rust-target ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && rustup target add "$(cat /tmp/rust-target)" \
    && cargo install --locked cargo-zigbuild --version 0.21.8

COPY Cargo.toml Cargo.lock ./
COPY .cargo ./.cargo
COPY crates ./crates
COPY examples ./examples
COPY proto ./proto

# Native BUILDPLATFORM rustc + Zig cross link (avoids qemu-user codegen bugs).
# PERTISK_BUILD_VERSION (from ARG VERSION) is baked into release_version().
RUN RUST_TARGET="$(cat /tmp/rust-target)" \
    && echo "==> cargo zigbuild PERTISK_BUILD_VERSION=${PERTISK_BUILD_VERSION} target=${RUST_TARGET}" \
    && cargo zigbuild --release -p pertiskd --target "${RUST_TARGET}" \
    && cp "target/${RUST_TARGET}/release/pertiskd" /pertiskd \
    && file /pertiskd \
    && if ! file /pertiskd | grep -Eqi 'statically linked|static-pie'; then \
         echo "ERROR: pertiskd must be statically linked for initramfs" >&2; \
         exit 1; \
       fi

FROM alpine:3.20 AS tools
ARG TARGETARCH
RUN apk add --no-cache sgdisk e2fsprogs dosfstools busybox parted \
    && mkdir -p /tools/bin /tools/lib \
    && cp /usr/bin/sgdisk /usr/sbin/partprobe /sbin/mkfs.ext4 /sbin/mkfs.vfat /bin/busybox /tools/bin/ \
    && ln -sf busybox /tools/bin/udhcpc \
    && for bin in /tools/bin/sgdisk /tools/bin/mkfs.ext4 /tools/bin/mkfs.vfat /tools/bin/partprobe; do \
         ldd "$bin" | awk '{print $3}' | grep -E '^/' | while read -r lib; do cp -n "$lib" /tools/lib/; done; \
       done \
    && case "${TARGETARCH}" in \
         amd64) cp /lib/ld-musl-x86_64.so.1 /tools/lib/ ;; \
         arm64) cp /lib/ld-musl-aarch64.so.1 /tools/lib/ ;; \
       esac

FROM debian:bookworm-slim AS pack
RUN apt-get update && apt-get install -y --no-install-recommends \
    cpio gzip \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /rootfs
COPY image/rootfs/ ./
COPY image/runtime-overlay/ ./
COPY image/boot-overlay/ ./
COPY --from=build /pertiskd ./init
COPY --from=tools /tools/bin/ ./usr/sbin/
COPY --from=tools /tools/bin/busybox ./bin/busybox
COPY --from=tools /tools/bin/udhcpc ./usr/sbin/udhcpc
COPY --from=tools /tools/lib/ ./lib/
RUN chmod +x ./init \
    && chmod +x ./usr/sbin/* ./bin/busybox 2>/dev/null || true \
    && mkdir -p proc sys dev run tmp var system/state etc sbin \
       usr/local/bin opt/cni/bin etc/cni/net.d etc/kubernetes/manifests boot/efi \
       usr/lib/pertisk/boot \
    && ln -sf /usr/sbin/sgdisk ./sbin/sgdisk \
    && ln -sf /usr/sbin/mkfs.ext4 ./sbin/mkfs.ext4 \
    && ln -sf /usr/sbin/mkfs.vfat ./sbin/mkfs.vfat \
    && ln -sf /usr/sbin/partprobe ./sbin/partprobe \
    && ln -sf /usr/sbin/udhcpc ./sbin/udhcpc \
    && if [ -f ./usr/local/bin/containerd ]; then chmod +x ./usr/local/bin/*; fi \
    && if [ -f ./opt/cni/bin/loopback ]; then chmod +x ./opt/cni/bin/*; fi \
    && find . | cpio -o -H newc | gzip -9 > /tmp/initramfs-base.cpio.gz \
    && if [ -f usr/lib/pertisk/boot/kernel ]; then \
         cp /tmp/initramfs-base.cpio.gz usr/lib/pertisk/boot/initramfs; \
         find . | cpio -o -H newc | gzip -9 > /initramfs.cpio.gz; \
       else \
         cp /tmp/initramfs-base.cpio.gz /initramfs.cpio.gz; \
       fi

FROM scratch AS export
COPY --from=pack /initramfs.cpio.gz /initramfs.cpio.gz
