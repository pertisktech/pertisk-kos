# Build linux pertisk-mgmt (+ pertiskctl) and package as RPM + DEB via nfpm.
# Used by: make mgmt-pkg / scripts/build-mgmt-pkg.sh
#
#   docker buildx build --platform linux/amd64 -f packaging/mgmt/Dockerfile.pkg ...
#   docker buildx build --platform linux/arm64 -f packaging/mgmt/Dockerfile.pkg ...
#
# Always RUN on BUILDPLATFORM (host). Arm64 packages are cross-compiled with
# cargo-zigbuild so we never execute aarch64 /bin/sh (QEMU "exec format error"
# with the docker driver on self-hosted amd64 runners).
# No apt-get: debian:bookworm-slim indexes often fail on those runners.
# rust:bookworm already has curl, unzip, xz-utils, ca-certificates, pkg-config.

ARG RUST_VERSION=1.88
ARG NFPM_VERSION=2.43.3
ARG PROTOC_VERSION=29.3
ARG ZIG_VERSION=0.13.0
ARG CARGO_ZIGBUILD_VERSION=0.23.0

FROM --platform=$BUILDPLATFORM node:22-bookworm AS ui
WORKDIR /ui
COPY web/mgmt-ui/package.json web/mgmt-ui/package-lock.json* ./
RUN npm ci || npm install
COPY web/mgmt-ui/ ./
ARG VERSION=0.1.0
ENV VITE_APP_VERSION=${VERSION}
RUN npm run build

FROM --platform=$BUILDPLATFORM rust:${RUST_VERSION}-bookworm AS build
ARG BUILDARCH
ARG TARGETARCH
ARG NFPM_VERSION=2.43.3
ARG PROTOC_VERSION=29.3
ARG ZIG_VERSION=0.13.0
ARG CARGO_ZIGBUILD_VERSION=0.23.0
# Host tools (protoc/nfpm/zig) match BUILDARCH; cargo-zigbuild emits TARGETARCH bins.
# Split RUNs so a curl HTTP 22 names the failing URL in the log.
RUN set -eu; \
    case "${BUILDARCH}" in \
      amd64) HOST_CPU=x86_64; PROTOC_ZIP=linux-x86_64; NFPM_TAR=Linux_x86_64 ;; \
      arm64) HOST_CPU=aarch64; PROTOC_ZIP=linux-aarch_64; NFPM_TAR=Linux_arm64 ;; \
      *) echo "unsupported BUILDARCH=${BUILDARCH}" >&2; exit 1 ;; \
    esac; \
    echo "BUILDARCH=${BUILDARCH} HOST_CPU=${HOST_CPU}"; \
    echo "==> protoc"; \
    curl -fL --retry 3 --retry-delay 2 \
      "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-${PROTOC_ZIP}.zip" \
      -o /tmp/protoc.zip; \
    unzip -o /tmp/protoc.zip -d /usr/local; \
    rm -f /tmp/protoc.zip; \
    chmod +x /usr/local/bin/protoc; \
    protoc --version; \
    echo "==> nfpm"; \
    curl -fL --retry 3 --retry-delay 2 \
      "https://github.com/goreleaser/nfpm/releases/download/v${NFPM_VERSION}/nfpm_${NFPM_VERSION}_${NFPM_TAR}.tar.gz" \
      -o /tmp/nfpm.tgz; \
    tar -xzf /tmp/nfpm.tgz -C /usr/local/bin nfpm; \
    rm -f /tmp/nfpm.tgz; \
    chmod +x /usr/local/bin/nfpm; \
    nfpm --version
RUN set -eu; \
    case "${BUILDARCH}" in \
      amd64) HOST_CPU=x86_64 ;; \
      arm64) HOST_CPU=aarch64 ;; \
      *) echo "unsupported BUILDARCH=${BUILDARCH}" >&2; exit 1 ;; \
    esac; \
    echo "==> zig ${ZIG_VERSION} (${HOST_CPU})"; \
    curl -fL --retry 3 --retry-delay 2 \
      "https://ziglang.org/download/${ZIG_VERSION}/zig-linux-${HOST_CPU}-${ZIG_VERSION}.tar.xz" \
      -o /tmp/zig.tar.xz; \
    tar -xJf /tmp/zig.tar.xz -C /usr/local; \
    rm -f /tmp/zig.tar.xz; \
    mv "/usr/local/zig-linux-${HOST_CPU}-${ZIG_VERSION}" /usr/local/zig; \
    ln -sf /usr/local/zig/zig /usr/local/bin/zig; \
    zig version
RUN set -eu; \
    case "${BUILDARCH}" in \
      amd64) CZ_ASSET=cargo-zigbuild-x86_64-unknown-linux-musl.tar.xz ;; \
      arm64) CZ_ASSET=cargo-zigbuild-aarch64-unknown-linux-gnu.tar.xz ;; \
      *) echo "unsupported BUILDARCH=${BUILDARCH}" >&2; exit 1 ;; \
    esac; \
    echo "==> cargo-zigbuild ${CARGO_ZIGBUILD_VERSION} ${CZ_ASSET}"; \
    curl -fL --retry 3 --retry-delay 2 \
      "https://github.com/rust-cross/cargo-zigbuild/releases/download/v${CARGO_ZIGBUILD_VERSION}/${CZ_ASSET}" \
      -o /tmp/cargo-zigbuild.tar.xz; \
    mkdir -p /tmp/cargo-zigbuild; \
    tar -xJf /tmp/cargo-zigbuild.tar.xz -C /tmp/cargo-zigbuild; \
    rm -f /tmp/cargo-zigbuild.tar.xz; \
    find /tmp/cargo-zigbuild -type f -name cargo-zigbuild -exec mv {} /usr/local/bin/cargo-zigbuild \;; \
    rm -rf /tmp/cargo-zigbuild; \
    chmod +x /usr/local/bin/cargo-zigbuild; \
    cargo-zigbuild --help >/dev/null
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY proto ./proto
COPY examples ./examples
COPY --from=ui /ui/dist ./crates/pertisk-mgmt/static
ARG VERSION=0.1.0
ENV PERTISK_BUILD_VERSION=${VERSION}
# Same-arch: native cargo (system libssl / gcc). Cross: cargo-zigbuild.
# rustls avoids openssl-sys, which commonly fails under zig (cargo exit 101).
RUN set -eu; \
    case "${TARGETARCH}" in \
      amd64) RUST_TARGET=x86_64-unknown-linux-gnu ;; \
      arm64) RUST_TARGET=aarch64-unknown-linux-gnu ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    mkdir -p /opt/bins; \
    if [ "${TARGETARCH}" = "${BUILDARCH}" ]; then \
      echo "==> native cargo build (${RUST_TARGET})"; \
      cargo build --release -p pertisk-mgmt -p pertiskctl; \
      cp target/release/pertisk-mgmt target/release/pertiskctl /opt/bins/; \
    else \
      echo "==> cargo zigbuild --target ${RUST_TARGET} (vendored OpenSSL)"; \
      rustup target add "${RUST_TARGET}"; \
      cargo zigbuild --release --target "${RUST_TARGET}" \
        -p pertisk-mgmt --features vendored-openssl \
        -p pertiskctl; \
      cp "target/${RUST_TARGET}/release/pertisk-mgmt" "target/${RUST_TARGET}/release/pertiskctl" /opt/bins/; \
    fi

FROM --platform=$BUILDPLATFORM build AS pkg
ARG TARGETARCH
ARG VERSION=0.1.0

WORKDIR /work
COPY packaging/mgmt /work/packaging/mgmt
COPY scripts /work/repo-scripts
COPY examples /work/repo-examples
RUN mkdir -p staging/usr/bin staging/usr/lib/systemd/system staging/etc/pertisk-mgmt staging/scripts \
      staging/usr/share/pertisk-mgmt/scripts staging/usr/share/pertisk-mgmt/examples /out \
  && chmod +x packaging/mgmt/scripts/*.sh \
  && cp -a /work/repo-scripts/. staging/usr/share/pertisk-mgmt/scripts/ \
  && cp -a /work/repo-examples/. staging/usr/share/pertisk-mgmt/examples/ \
  && chmod +x staging/usr/share/pertisk-mgmt/scripts/*.sh

COPY --from=build /opt/bins/pertisk-mgmt staging/usr/bin/pertisk-mgmt
COPY --from=build /opt/bins/pertiskctl staging/usr/bin/pertiskctl
COPY packaging/mgmt/pertisk-mgmt.service staging/usr/lib/systemd/system/pertisk-mgmt.service
COPY packaging/mgmt/pertisk-mgmt.env staging/etc/pertisk-mgmt/pertisk-mgmt.env
COPY packaging/mgmt/scripts/preinstall.sh staging/scripts/preinstall.sh
COPY packaging/mgmt/scripts/postinstall.sh staging/scripts/postinstall.sh
COPY packaging/mgmt/scripts/preremove.sh staging/scripts/preremove.sh

RUN set -eu; \
    case "${TARGETARCH}" in \
      amd64|arm64) ARCH="${TARGETARCH}" ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    sed -e "s|\${VERSION}|${VERSION}|g" \
        -e "s|\${ARCH}|${ARCH}|g" \
        -e "s|\${STAGING}|/work/staging|g" \
        packaging/mgmt/nfpm.yaml.tmpl > nfpm.yaml; \
    nfpm package --config nfpm.yaml --packager rpm --target /out/; \
    nfpm package --config nfpm.yaml --packager deb --target /out/; \
    ls -lh /out/

FROM scratch AS export
COPY --from=pkg /out/ /
