# Pertisk management (API + embedded UI) — /etc/pertisk-mgmt/pertisk-mgmt.env
#
# Change MGMT_SECRET_KEY before production use. Keep it stable across restarts
# or encrypted provider secrets will not decrypt.

MGMT_LISTEN=0.0.0.0:8080
MGMT_DB=/var/lib/pertisk-mgmt/mgmt.db
MGMT_DATA_DIR=/var/lib/pertisk-mgmt
MGMT_PERTISKCTL=/usr/bin/pertiskctl
MGMT_LAB_UP=/usr/share/pertisk-mgmt/scripts/proxmox-lab-up.sh

# --- Cloud images on mgmt only (create jobs use --skip-build) ---
# Stage from a build host → /var/lib/pertisk-mgmt/images/
# Create uploads to Proxmox via API (no scp to the PVE node).
PERTISK_IMAGES_DIR=/var/lib/pertisk-mgmt/images

# --- Proxmox disk import (Omni-style: API only, no SSH) ---
# Provider token in the UI is enough. Upload hop uses directory storage
# (usually "local"); VM disks can still be local-zfs / local-lvm.
PROXMOX_NO_SSH=1
PROXMOX_UPLOAD_STORAGE=local
LAB_SUBNET=10.1.1.0/24
# Optional override for AHV IPAM netcfg default route. When unset, upload detects
# Prism subnet default_gateway, then mgmt `ip route default` on the guest L2.
# LAB_GATEWAY=10.1.1.10

# Optional: scp + qm importdisk instead of API (needs keys for user pertisk-mgmt):
# PROXMOX_SSH=root@10.1.1.195
# PROXMOX_SSH_AUTO=1

MGMT_ADMIN_USER=admin
# Set on first install, then remove or leave empty (admin is only seeded once).
MGMT_ADMIN_PASSWORD=admin
MGMT_SECRET_KEY=change-me-to-a-stable-secret

# Public URL shown on guest serial dashboard + used for OIDC callbacks.
# REQUIRED when MGMT_LISTEN=0.0.0.0:… (do not leave unset — guests must not see 0.0.0.0).
# Example: MGMT_PUBLIC_URL=https://mgmt.example.com
# MGMT_PUBLIC_URL=http://192.0.2.10:8080

# AUTH_MODE=local
# MGMT_METRICS_TOKEN=
# MGMT_ALLOW_LAB_STUB=1
# Longer apiserver wait after bootstrap (seconds; lab-up default 600):
# BOOTSTRAP_TIMEOUT=900
